{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/resume",
      "dest": "/api/resume"
    },
    {
      "src": "/resume",
      "dest": "/resume"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
